{
  "manifest_version": 3,
  "name": "Nra Assist",
  "version": "1.0",
  "permissions": [
    "scripting",
    "tabs",
    "activeTab",
    "debugger"
  ],
  "description": "Това разширение попълва годишната данъчна декларация към НАП автоматично, използвайки входни данни от Nra Assist.",
  "host_permissions": [
    "https://portal.nra.bg/*"
  ],
  "action": {
    "default_icon": {
      "16": "icon16.png",
      "32": "icon32.png",
      "48": "icon48.png",
      "128": "icon128.png"
    },
    "default_popup": "index.html"
  },
  "icons": {
    "16": "icon16.png",
    "32": "icon32.png",
    "48": "icon48.png",
    "128": "icon128.png"
  }
}
